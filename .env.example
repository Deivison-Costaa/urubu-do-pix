# Copie para .env antes de subir o ambiente: cp .env.example .env
# Credenciais só para desenvolvimento local. O .env não é versionado.
# No Projeto 03 os segredos passam para um gerenciador de segredos (ADR-0005).

PG_PASSWORD=troque-esta-senha-pg
REDIS_PASSWORD=troque-esta-senha-redis
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-grafana

# Versão gravada nos binários e nas métricas.
VERSAO=dev

# Porta do API Gateway no host (mude se a 8080 estiver ocupada).
GATEWAY_PORTA=8080
